FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build
COPY pyproject.toml README.md ./
COPY aether ./aether
RUN pip install --no-cache-dir '.[dev]' && pip cache purge

WORKDIR /workspace
USER 65534:65534

# The runtime overrides this CMD with the pytest command.
CMD ["python", "-m", "pytest", "-q"]
