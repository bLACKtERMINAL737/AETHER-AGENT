CROWS_MODEL_BASE_URL=
CROWS_MODEL_API_KEY=
CROWS_MODEL_NAME=
CROWS_CODING_MODEL_BASE_URL=
CROWS_CODING_MODEL_API_KEY=
CROWS_CODING_MODEL_NAME=
CROWS_FALLBACK_MODEL_BASE_URL=
CROWS_FALLBACK_MODEL_API_KEY=
CROWS_FALLBACK_MODEL_NAME=
CROWS_REASONING_MODEL_BASE_URL=
CROWS_REASONING_MODEL_API_KEY=
CROWS_REASONING_MODEL_NAME=

# HTTP timeout for each configured model route in seconds (effective range 1-600; default 45).
CROWS_MODEL_TIMEOUT_SECONDS=45

CROWS_DB_PATH=./data/aether.sqlite3
CROWS_WORKSPACE=./workspace

# Test execution is disabled unless explicitly enabled.
# WARNING: pytest executes code and is not OS-sandboxed in this MVP.
CROWS_ENABLE_TEST_RUNNER=false
CROWS_TEST_TIMEOUT_SECONDS=60
CROWS_SANDBOX_IMAGE=crows-sandbox:latest

# Optional shared token for API endpoints. Keep the API bound to 127.0.0.1.
# Generate a long random value and enter it in the local UI for this browser tab.
CROWS_API_TOKEN=

# Maximum runtime for one specialist or QA task (seconds; default 120, effective range 1-600).
CROWS_AGENT_TASK_TIMEOUT_SECONDS=120

# Maximum number of independent specialist tasks to run concurrently (effective range 1-3).
CROWS_AGENT_MAX_CONCURRENCY=3
