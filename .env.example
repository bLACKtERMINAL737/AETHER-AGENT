AETHER_MODEL_BASE_URL=
AETHER_MODEL_API_KEY=
AETHER_MODEL_NAME=
AETHER_CODING_MODEL_BASE_URL=
AETHER_CODING_MODEL_API_KEY=
AETHER_CODING_MODEL_NAME=
AETHER_FALLBACK_MODEL_BASE_URL=
AETHER_FALLBACK_MODEL_API_KEY=
AETHER_FALLBACK_MODEL_NAME=
AETHER_REASONING_MODEL_BASE_URL=
AETHER_REASONING_MODEL_API_KEY=
AETHER_REASONING_MODEL_NAME=

AETHER_DB_PATH=./data/aether.sqlite3
AETHER_WORKSPACE=./workspace

# Test execution is disabled unless explicitly enabled.
# WARNING: pytest executes code and is not OS-sandboxed in this MVP.
AETHER_ENABLE_TEST_RUNNER=false
AETHER_TEST_TIMEOUT_SECONDS=60
AETHER_SANDBOX_IMAGE=aether-sandbox:latest

# Optional shared token for API endpoints. Keep the API bound to 127.0.0.1.
# Generate a long random value and enter it in the local UI for this browser tab.
AETHER_API_TOKEN=

# Maximum runtime for one specialist or QA task (seconds; default 120, effective range 1-600).
AETHER_AGENT_TASK_TIMEOUT_SECONDS=120

# Maximum number of independent specialist tasks to run concurrently (effective range 1-3).
AETHER_AGENT_MAX_CONCURRENCY=3
